# Copy this file to `.env` and replace EVERY `your_...` placeholder with your own value:
#   Windows (cmd):        copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#
# `.env` is ignored by git and must NEVER be committed or pushed. Only this example is versioned,
# and it must contain generic placeholders only — never real values or secrets.

# --- Database engine (starts empty; the API's migrations create the schema) -------------------
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
DB_PORT=5432

# --- API (Laravel) --------------------------------------------------------------------------
# local | demo | production. Only `demo` enables the X-Demo-Now header used by the seeder.
APP_ENV=local
APP_DEBUG=false
# Generate with: docker compose run --rm --no-deps api php artisan key:generate --show
APP_KEY=
# Long random string used to sign the 8-hour access tokens.
JWT_SECRET=your_long_random_jwt_secret
# Initial administrator, created by the API at startup.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
CORS_ORIGIN=http://localhost:5173
API_PORT=8000

# --- Frontend (React) and public page ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
APP_PORT=5173
PAGE_PORT=8080

# --- Paths to the sibling repositories (clone them side by side) ---------------------------------
API_DIR=../test-manager-library-3145556-api
APP_DIR=../test-manager-library-3145556-app
PAGE_DIR=../test-manager-library-3145556-page
